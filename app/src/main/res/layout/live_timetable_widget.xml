<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="7dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="London (Any) → Royston"
            android:textColor="#18201E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="LIVE · 30m"
            android:textColor="#173F38"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="39dp"
            android:layout_height="23dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Toggle live updates"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_toggle_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_line_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="17:17 Kings Lynn · Dep 17:36→18:22 · P1 · +19m"
        android:textColor="#18201E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_line_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#25302D"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_line_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#25302D"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="30s"
            android:textColor="#62706C"
            android:textSize="9sp" />

        <Chronometer
            android:id="@+id/widget_age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:format="updated %s ago"
            android:textColor="#62706C"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/widget_open_background"
            android:text="OPEN"
            android:textColor="#123F36"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
